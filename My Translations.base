filters:
  and:
    - file.inFolder("pericope")
views:
  - type: table
    name: Pericope
    order:
      - book/chapter
      - pericope
      - translation_status
      - translation_difficulty
      - translation_priority
      - translation_needs_review
    sort:
      - property: status
        direction: ASC
      - property: file.path
        direction: ASC
    columnSize:
      note.book/chapter: 149
      note.pericope: 320
      note.verse_count: 120
